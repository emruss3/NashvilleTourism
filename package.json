{
  "name": "nashville-guide",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prebuild": "node --experimental-strip-types tests/media-usage.test.ts && node --experimental-strip-types tests/stay-links.test.ts && node --experimental-strip-types tests/hotel-rank.test.ts",
    "test:media": "node --experimental-strip-types tests/media-usage.test.ts",
    "test:stay": "node --experimental-strip-types tests/stay-links.test.ts",
    "test:hotels": "node --experimental-strip-types tests/hotel-rank.test.ts",
    "media:restore": "python scripts/media/restore_selected_images.py && python scripts/media/generate_restored_registry.py",
    "media:qa": "python scripts/media/qa_image_routes.py",
    "serve": "npx --yes serve out -l 3000",
    "import:fsq-os": "node scripts/import-fsq-os.mjs",
    "sync:overture-places": "python scripts/sync-overture-places.py"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@supabase/supabase-js": "^2.112.2",
    "next": "15.5.25",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.19",
    "axe-core": "^4.12.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.5.25",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0"
  }
}
