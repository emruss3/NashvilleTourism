# Copy to .env.local and fill in. Optional integrations degrade gracefully
# when credentials are absent. The white-label shop renders a setup state until
# its Shopify variables are present.

# ---------------------------------------------------------------------------
# Site identity
# ---------------------------------------------------------------------------
# The canonical origin. Used for metadataBase, canonical URLs, OG tags, the
# sitemap, and robots.txt. Must be a parseable absolute URL.
NEXT_PUBLIC_SITE_URL=https://www.nashroam.com

# Only needed when deploying under a repo subpath, e.g. GitHub Project Pages.
# Leave blank for nashroam.com and Vercel.
NEXT_PUBLIC_BASE_PATH=

# Crawl safety: remains noindex until this is explicitly enabled AND all
# placeholder launch identity fields in src/lib/site.ts have been replaced.
NEXT_PUBLIC_ALLOW_INDEXING=false

# ---------------------------------------------------------------------------
# White-label Shopify storefront
# ---------------------------------------------------------------------------
# Install Shopify's Headless sales channel, create a NashRoam storefront, and
# use the PRIVATE Storefront API token here. Never prefix this variable with
# NEXT_PUBLIC and never expose it to browser code.
SHOPIFY_STORE_DOMAIN=nashroam.myshopify.com
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-07

# Optional: restrict the site to one Shopify collection. If blank, the shop
# displays all products published to the Headless storefront.
SHOPIFY_COLLECTION_HANDLE=nashroam

# Printful connects directly to Shopify through the official Printful app.
# No Printful API key belongs in this site for standard order fulfillment.

# ---------------------------------------------------------------------------
# Live events feed (Ticketmaster Discovery API)
# ---------------------------------------------------------------------------
# Free key: https://developer.ticketmaster.com/
# Fetched at BUILD time, not per request. Free tier allows 5 req/sec and
# 5,000/day, so rebuild on a schedule rather than calling per visitor.
# Without this, /live-music-tonight/ shows seeded sample shows and says so.
TICKETMASTER_API_KEY=

# ---------------------------------------------------------------------------
# Reviews
# ---------------------------------------------------------------------------
# Google Places. Returns at most 5 reviews per place. Terms require attribution
# to Google, forbid caching most Places data beyond 30 days, and require a link
# back to the Google listing. The display component handles all three.
GOOGLE_PLACES_API_KEY=

# TripAdvisor Content API. Requires an APPROVED partner account, not just a
# signup. The licence permits a rating and review count with their branding and
# a link, but does NOT permit reproducing full review text, which is why the
# adapter returns no snippets for this provider.
TRIPADVISOR_API_KEY=

# ---------------------------------------------------------------------------
# Affiliate / partner IDs
# ---------------------------------------------------------------------------
# Public by nature: these end up in outbound URLs in the browser. Without them
# the booking links still work, they just carry no attribution.
NEXT_PUBLIC_BOOKING_AID=
NEXT_PUBLIC_VIATOR_PID=
NEXT_PUBLIC_TM_AFFILIATE=
NEXT_PUBLIC_VRBO_AID=

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------
# Events are pushed to window.dataLayer by src/lib/analytics.ts. Connect a
# provider in src/app/layout.tsx. See docs/ANALYTICS.md for the event contract.
NEXT_PUBLIC_GA_ID=
