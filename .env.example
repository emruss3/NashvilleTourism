# Copy to .env.local and fill in. Nothing here is required to run the site:
# every integration degrades gracefully when its key is absent, so the build
# never fails because a credential is missing.

# ---------------------------------------------------------------------------
# Site identity
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ALLOW_INDEXING=
NEXT_PUBLIC_SITE_URL=https://www.nashroam.com
NEXT_PUBLIC_BASE_PATH=

# ---------------------------------------------------------------------------
# Supabase (Nashroam project — server-only service role)
# ---------------------------------------------------------------------------
# Project ref: aeomrsutkhwmnscvvfur
# REQUIRED on Vercel Production + Preview for /tours, /plan, /admin, planner APIs.
# NEVER put the service role in NEXT_PUBLIC_* or client bundles.
SUPABASE_URL=https://aeomrsutkhwmnscvvfur.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://aeomrsutkhwmnscvvfur.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Internal Nashroam admin (server-only)
# ---------------------------------------------------------------------------
# Required for /admin/experiences and /admin/places. Login exchanges this secret
# for a cryptographically expiring 12-hour HttpOnly/SameSite=Strict cookie.
NASHROAM_ADMIN_TOKEN=

# Optional manual ops endpoint token. Normal provider refreshes should run via
# Supabase Cron/Edge Functions rather than exposed website endpoints.
NASHROAM_SYNC_TOKEN=

# ---------------------------------------------------------------------------
# Ticketmaster
# ---------------------------------------------------------------------------
# PREFERRED: set TICKETMASTER_API_KEY as a Supabase Edge Function secret for
# `ticketmaster-sync`, not on Vercel. The canonical Supabase event feed is the
# production path.
#
# LEGACY TRANSITION ONLY: src/lib/feeds/ticketmaster.ts still supports a direct
# server-side Vercel/local key until the first Supabase event sync is verified.
# Remove this website-side key after migration is complete.
TICKETMASTER_API_KEY=

# ---------------------------------------------------------------------------
# Reviews (website-side legacy/transitional adapters)
# ---------------------------------------------------------------------------
GOOGLE_PLACES_API_KEY=
TRIPADVISOR_API_KEY=

# ---------------------------------------------------------------------------
# Affiliate / partner IDs
# ---------------------------------------------------------------------------
# Deprecated for tours deep-links. Tours use Supabase → Edge Function → Viator.
NEXT_PUBLIC_VIATOR_PID=
NEXT_PUBLIC_TM_AFFILIATE=

# ---------------------------------------------------------------------------
# Hotel booking: Nuitée white-label site (docs/HOTEL-BOOKING.md)
# ---------------------------------------------------------------------------
# Host of the hosted booking site. stay.nashroam.com now, stay.nashville.com
# after DNS cutover. Unset = hotel CTAs fall back to their search links.
NEXT_PUBLIC_STAY_HOST=stay.nashroam.com
# Google Place ID for Nashville, TN (locality, 36.1627 -86.7816). Used only by
# the white-label listing fallback; a wrong value degrades gracefully.
NEXT_PUBLIC_NASHVILLE_PLACE_ID=ChIJPZDrEzLsZIgRoNrpodC5P30
# Experimental /booking?offerId= links. Keep off until Nuitée confirms.
NEXT_PUBLIC_STAY_DIRECT_CHECKOUT=false
# ---------------------------------------------------------------------------
# Private events marketplace (docs/PRIVATE-EVENTS.md). Server only.
# ---------------------------------------------------------------------------
# Resend API key. Unset = every send is logged as skipped, intake still works.
RESEND_API_KEY=
# Verified sender on the Resend domain (mail.nashroam.com now, mail.nashville.com later).
EVENTS_FROM_EMAIL=Nashville.com events desk <events@mail.nashroam.com>
# Every inquiry is copied here; nothing depends on someone reading it, but someone does.
EVENTS_DESK_EMAIL=
# Inquiries that need a room block are also copied here.
GROUP_HOTELS_EMAIL=
# 32+ random characters. Signs the venue reply links; rotating it invalidates open links.
EVENTS_MAGIC_LINK_SECRET=
# Same value as the Vault secret nashroam_cron_token; unlocks /api/private-events/sla/ for pg_cron.
NASHROAM_CRON_TOKEN=

# LiteAPI keys never live here: LITEAPI_SANDBOX_KEY, LITEAPI_PRODUCTION_API_KEY,
# LITEAPI_ENV, LITEAPI_PROBE_TOKEN and NASHROAM_CRON_TOKEN are Supabase Edge
# Function secrets read by liteapi-live. Live rates on the site need
# SUPABASE_SERVICE_ROLE_KEY (above), the same as tours.

# ---------------------------------------------------------------------------
# Viator Partner API v2
# ---------------------------------------------------------------------------
# DO NOT set VIATOR_API_KEY on Vercel for the Nashroam site.
# The key lives in Supabase Edge Function secrets (sandbox Basic Access today).
# Nashville destination ID: 799. Production remains disabled until a production
# key exists.

# ---------------------------------------------------------------------------
# Overture place sync (GitHub Action / local scripts only — never browser)
# ---------------------------------------------------------------------------
# No Overture API key. Writes require SUPABASE_SERVICE_ROLE_KEY above.
# Optional bbox override (min_lon,min_lat,max_lon,max_lat):
# NASHVILLE_BBOX=-87.06,35.97,-86.46,36.41
# MIN_CANDIDATE_SCORE=70

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=G-X1YXCSYL9B


# NSVL commerce: server-only Shopify Headless credentials
SHOPIFY_STORE_DOMAIN=1st1aa-w4.myshopify.com
SHOPIFY_STOREFRONT_PRIVATE_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=2026-07
SHOPIFY_COLLECTION_HANDLE=nashroam
