# Copy to .env.local and fill in. Nothing here is required to run the site:
# every integration degrades gracefully when its key is absent, so the build
# never fails because a credential is missing.

# ---------------------------------------------------------------------------
# Site identity
# ---------------------------------------------------------------------------
# Crawl safety for non-production builds.
# - Preview/development Vercel deploys are always noindex.
# - Production on nashroam.com auto-indexes (no flag required).
# - Set to "true" only when indexing a non-nashroam production host.
NEXT_PUBLIC_ALLOW_INDEXING=
# The canonical origin. Used for metadataBase, canonical URLs, OG tags, the
# sitemap, and robots.txt. Must be a parseable absolute URL.
NEXT_PUBLIC_SITE_URL=https://www.nashroam.com

# Only needed when deploying under a repo subpath, e.g. GitHub Project Pages
# at https://user.github.io/NashvilleTourism. Leave blank for a root domain.
NEXT_PUBLIC_BASE_PATH=

# ---------------------------------------------------------------------------
# Supabase (Nashroam project — server-only service role)
# ---------------------------------------------------------------------------
# Project ref: aeomrsutkhwmnscvvfur
# Required for experiences catalog, Viator Edge Function calls, planner candidates.
# NEVER put the service role in NEXT_PUBLIC_* or client bundles.
SUPABASE_URL=https://aeomrsutkhwmnscvvfur.supabase.co
# Optional public URL alias (same project URL). Safe to expose if used only for
# anon clients later; today the app uses the service role server-side.
NEXT_PUBLIC_SUPABASE_URL=https://aeomrsutkhwmnscvvfur.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Live events feed (Ticketmaster Discovery API)
# ---------------------------------------------------------------------------
# Free key: https://developer.ticketmaster.com/
# Fetched at BUILD time, not per request. Free tier allows 5 req/sec and
# 5,000/day, so rebuild on a schedule rather than calling per visitor.
# Without this, /live-music-tonight/ shows seeded sample shows and says so.
TICKETMASTER_API_KEY=

# ---------------------------------------------------------------------------
# Reviews
# ---------------------------------------------------------------------------
# Google Places. Returns at most 5 reviews per place. Terms require attribution
# to Google, forbid caching most Places data beyond 30 days, and require a link
# back to the Google listing. The display component handles all three.
GOOGLE_PLACES_API_KEY=

# TripAdvisor Content API. Requires an APPROVED partner account, not just a
# signup. The licence permits a rating and review count with their branding and
# a link, but does NOT permit reproducing full review text, which is why the
# adapter returns no snippets for this provider.
TRIPADVISOR_API_KEY=

# ---------------------------------------------------------------------------
# Affiliate / partner IDs
# ---------------------------------------------------------------------------
# Public by nature: these end up in outbound URLs in the browser. Without them
# the booking links still work, they just carry no attribution.
NEXT_PUBLIC_BOOKING_AID=
# Deprecated for tours deep-links. Tours use Supabase → Edge Function → Viator.
# Kept only if you still need a legacy PID reference elsewhere.
NEXT_PUBLIC_VIATOR_PID=
NEXT_PUBLIC_TM_AFFILIATE=
NEXT_PUBLIC_VRBO_AID=

# ---------------------------------------------------------------------------
# Viator Partner API v2
# ---------------------------------------------------------------------------
# DO NOT set VIATOR_API_KEY on Vercel for the NashRoam site.
# The key lives in Supabase Edge Function secrets (sandbox Basic Access today).
# Nashville destination ID: 799. Base URL default: api.sandbox.viator.com.
# Production Viator must not be called until a production key exists.

# ---------------------------------------------------------------------------
# Booking.com Demand API (server-only — hotels, not Viator)
# ---------------------------------------------------------------------------
# Until issued, /hotels stays graceful fallback (sample catalog ≠ live inventory).
BOOKING_DEMAND_API_KEY=
BOOKING_DEMAND_AFFILIATE_ID=

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------
# GA4 measurement ID. Loaded once from src/app/layout.tsx (gtag.js).
# Custom events still go through window.dataLayer via src/lib/analytics.ts —
# see docs/ANALYTICS.md for the event contract.
NEXT_PUBLIC_GA_ID=G-X1YXCSYL9B
